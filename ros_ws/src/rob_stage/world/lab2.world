include "include/pioneer.inc"
include "include/map.inc"
include "include/sick.inc"
include "include/box.inc"

# spatial resolution of the underlying occupancy grid. Default is 0.02m.
resolution 0.02

# set the multiple of real time that Stage should try to achieve. Default is 1. 
# set to 0 to go as fast as possible.
speedup 1

# configure the GUI window
window
(
  size [ 800 400 ] # in pixels
  scale 36.995   # pixels per meter
  center [ 0.0  0.0 ]
  rotate [ 0  0 ]
        
  show_data 1              # 1=on 0=off
)

define floorplan model
(
  # sombre, sensible, artistic
  color "gray30"

  # most maps will need a bounding box
  boundary 1

  gui_nose 0
  gui_grid 0

  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)


# load an environment bitmap
floorplan
( 
  name "simple_maze"
  size [20.000 8.000 0.800]
  pose [0 0 0 0]
  bitmap "bitmaps/simple_maze.png"
)


pioneer2dx_base_no_sonar
(     
  # can refer to the robot by this name
  name "robot"
  pose [ -7 2 0 0 ] 

  sicklaser( pose [ 0 0 0 0 ] ) 
 
  trail_length 400
)

define goal model
(
      block
      (
            points 4
            point[0] [0.25 -0.25]
            point[1] [0.25 0.25]
            point[2] [-0.25 0.25]
            point[3] [-0.25 -0.25]
            z [-2 0]
      )

      # 
      size [0.0 0.0 0.0]

      color "DarkGreen"
)
# Uncomment these if you want to see the goals, but then they'll be collidable...
#goal(name "goal1" pose [ -9 0 0 0])
#goal(name "goal2" pose [ -9 -2.5 0 0])
#goal(name "goal3" pose [ -3 -2.5 0 0])
#goal(name "goal4" pose [ -3  2.5 0 0])
#goal(name "goal5" pose [ -0.5  2 0 0])
#goal(name "goal6" pose [ 2.0  -0.5 0 0])
#goal(name "goal7" pose [ 2.5  2.0 0 0])
#goal(name "goal8" pose [ 5.0  0.0 0 0])
#goal(name "goal9" pose [ 8.0  2.0 0 0])
box(name "box1" pose [ -6.5 -2.5 0 0 ])
box(name "box2" pose [ -4.0 -2.1 0 0 ])
box(name "box3" pose [ -2.4 1.6 0 0 ])

